# Copy this file to ".env" in the same folder to enable Real Email and/or SMS OTP.

# ==============================================================================
# Option A (FREE): Real Email OTP via Gmail
# 1. Enable 2-Step Verification on your Google Account
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Paste your Gmail and 16-character App Password below:
# ==============================================================================
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ==============================================================================
# Option B (SMS): Fast2SMS (India) or Twilio (Global)
# ==============================================================================
# Fast2SMS (https://www.fast2sms.com/)
FAST2SMS_API_KEY=

# Twilio (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
